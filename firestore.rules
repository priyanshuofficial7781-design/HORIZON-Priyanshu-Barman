rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Real-time app state synchronization across devices
      match /app_state/{stateId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(stateId);
        allow delete: if isOwner(userId) && isValidId(stateId);
      }

      // Focus sessions subcollection
      match /focus_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(sessionId);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Custom YouTube lectures subcollection
      match /custom_lectures/{lectureId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(lectureId);
        allow delete: if isOwner(userId) && isValidId(lectureId);
      }
    }
  }
}
